<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧡 Epinoia 桌宠设置"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="形象固定为橙色方块小人（无嘴设定），所有功能可在此开关。"
            android:textSize="12sp"
            android:textColor="#888888" />

        <!-- 权限区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="🔐 权限设置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btn_overlay_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="悬浮窗权限（必需）" />

        <Button
            android:id="@+id/btn_notif_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="通知权限（保活用）" />

        <Button
            android:id="@+id/btn_storage_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="文件访问权限（AI 消息通道用）" />

        <!-- 功能开关区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="🎛️ 功能开关"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <Switch
            android:id="@+id/sw_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="悬浮球贴边（无操作10s自动贴边半透明）" />

        <Switch
            android:id="@+id/sw_edge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="边缘跑（随机沿屏幕边缘滑跑）" />

        <Switch
            android:id="@+id/sw_peek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="躲猫猫（随机消失→随机位置现身）" />

        <Switch
            android:id="@+id/sw_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自主小动作（13种动作/连击/时段/孤独）" />

        <Switch
            android:id="@+id/sw_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="喝水提醒（每2小时）" />

        <Switch
            android:id="@+id/sw_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="键盘感知（键盘弹出时趴到键盘上方）" />

        <Switch
            android:id="@+id/sw_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI 消息通道（监听 /sdcard/Deskpet/messages.txt）" />

        <!-- 启动/停止 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="🚀 启动桌宠" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⏹ 停止桌宠" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:text="💡 AI 消息文件格式：动作名|消息文本\n例：jump|嘿嘿我跳啦\n动作：happy/sleepy/angry/cry/proud/jump/wiggle/music/shock/think/celebrate/cute/run"
            android:textSize="11sp"
            android:textColor="#999999" />
    </LinearLayout>
</ScrollView>
